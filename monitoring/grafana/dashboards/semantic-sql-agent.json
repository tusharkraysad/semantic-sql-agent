{
 "title": "Semantic SQL Agent",
 "uid": "sqlagent",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "type": "timeseries",
   "title": "Questions per minute by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(sqlagent_questions_total[5m])) * 60",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p95 latency by path",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, mode) (rate(sqlagent_question_seconds_bucket[5m])))",
     "legendFormat": "{{mode}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Share of answers below the confidence floor",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(sqlagent_confidence_bucket{le=\"0.55\"}[15m])) / sum(rate(sqlagent_confidence_count[15m]))",
     "legendFormat": "below floor",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Empty results and clarifications per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(sqlagent_empty_results_total[1h]) * 3600",
     "legendFormat": "empty results",
     "refId": "A"
    },
    {
     "expr": "rate(sqlagent_clarifications_total[1h]) * 3600",
     "legendFormat": "clarifications",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Cache hit rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(sqlagent_cache_total{result=\"hit\"}[15m])) / sum(rate(sqlagent_cache_total[15m]))",
     "legendFormat": "hit rate",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Model tokens per minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (kind) (rate(sqlagent_llm_tokens_total[5m])) * 60",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Unverified figures per hour (citation check)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(sqlagent_unverified_figures_total[1h]) * 3600",
     "legendFormat": "unverified",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Unrecognised question words per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(sqlagent_unresolved_terms_total[1h]) * 3600",
     "legendFormat": "unresolved terms",
     "refId": "A"
    }
   ]
  }
 ]
}