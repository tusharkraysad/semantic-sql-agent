# Copy to .env. Everything works with LLM_PROVIDER=none (fully deterministic).
LLM_PROVIDER=none

# Any OpenAI-compatible endpoint works. Examples (check each provider's current free tier and model names):
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=
# LLM_API_KEY=
# PLANNER_MODEL=
# WRITER_MODEL=
